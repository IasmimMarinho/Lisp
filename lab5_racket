(define (validar-id id)
  (cond
    ; Não é uma string
    [(not (string? id))
     (error "ID inválido: Esperava uma string com pelo menos 5 caracteres, mas recebi o valor: ~v" id)]
    
    ; É uma string, mas tem menos de 5 caracteres
    [(< (string-length id) 5)
     (error "ID inválido: Esperava uma string com pelo menos 5 caracteres, mas recebi ~a"
            (string-length id))]

    ; O id é válido
    [else id]))


; Fazer testes de Verificação


; Teste 1:Quando o id for uma string com 4 caracteres, o código deve levantar uma exceção.
(check-exn
  exn:fail?
  (lambda () (validar-id "1234")))

; Teste 2: Quando o id for uma string com exatamente 5 caracteres, deve retornar o id corretamente
(check-equal? (validar-id "abcde") "abcde")

;Quando o id for um valor não string (por exemplo, um número), o código deve levantar uma exceção.
(check-exn
  exn:fail?
  (lambda () (validar-id 10)))
